# Copy to .env for local use. On Vercel, add the same names under Project → Settings → Environment Variables.
# Never put SUPABASE_SERVICE_ROLE_KEY or Stripe secret keys in the browser / config.js / GitHub.

# Public site URL (no trailing slash)
SITE_URL=https://aryam.us

# Supabase (Settings → API) — project dashboard:
# https://supabase.com/dashboard/project/YOUR_PROJECT_REF
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here

# Server-only (Edge Functions secrets / backend). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe (Publishable = browser OK; Secret = Edge Function only)
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google Places (for live reviews + profile photos — Edge Function secret)
GOOGLE_MAPS_API_KEY=your_google_maps_places_key
GOOGLE_PLACE_ID=ChIJvZYXdLTDQIYRthuVnPvmRzI

# Instagram API is OPTIONAL and only works if the Instagram account owner
# gives you a Meta token. Without it, the site uses:
# 1) public Instagram profile embed (no login)
# 2) up to 9 public post/reel links in data/instagram.posts.json
#    (anyone can Copy link from a public post — no password needed)

ADMIN_DEMO_PASSWORD=aryam-admin-2026

# Cloudinary (product photos CDN — preferred over Supabase Storage for images)
# Dashboard: https://console.cloudinary.com → Settings → Product environment credentials
# 1) Copy Cloud name → CLOUDINARY_CLOUD_NAME
# 2) Settings → Upload → Add upload preset → Signing mode: Unsigned
#    Folder: aryam/products → CLOUDINARY_UPLOAD_PRESET
# Also copy cloud name + unsigned preset into js/shop/config.js (browser needs them).
# API Key / API Secret stay in .env / Vercel only — never in the browser.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=aryam_unsigned
CLOUDINARY_FOLDER=aryam/products
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
