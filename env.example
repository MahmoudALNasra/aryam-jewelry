# Copy values into js/shop/config.js (or set via your host’s env injection).
# Never put Stripe secret keys in the browser — only in Supabase Edge Function secrets.

# Public site URL (no trailing slash) — used for product links & Merchant Center export
SITE_URL=https://techrevenuebrief.com/aryam

# Supabase project (Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Stripe (Publishable key is safe in the browser; Secret key → Edge Function only)
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Admin demo gate (used only when Supabase Auth is not configured)
ADMIN_DEMO_PASSWORD=aryam-admin-2026
