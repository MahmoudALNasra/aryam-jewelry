# Copy to .env for local use. On Vercel, add the same names under Project → Settings → Environment Variables.
# Never put SUPABASE_SERVICE_ROLE_KEY or Stripe secret keys in the browser / config.js / GitHub.

# Public site URL (no trailing slash)
SITE_URL=https://aryam.us

# Supabase (Settings → API) — project dashboard:
# https://supabase.com/dashboard/project/YOUR_PROJECT_REF
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here

# Server-only (Edge Functions secrets / backend). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe (Publishable = browser OK; Secret = Edge Function only)
STRIPE_PUBLISHABLE_KEY=pk_test_...

ADMIN_DEMO_PASSWORD=aryam-admin-2026
